{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sarkaridoc-studio",
  "compatibility_date": "2026-08-03",
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}

